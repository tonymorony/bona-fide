{
  "name": "bona-fide",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "sdk",
    "app",
    "agent",
    "web"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "npm run format --workspaces && prettier --write eslint.config.ts",
    "format:check": "npm run format:check --workspaces && prettier --check eslint.config.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "lint:sol": "cd contracts && forge fmt --check && forge lint --deny warnings",
    "lint:sh": "scripts/lint-shell.sh",
    "check": "scripts/check.sh",
    "security": "scripts/security.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
