{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api */merge)",
      "Bash(gh api */merge *)",
      "Bash(gh api */merges)",
      "Bash(gh api */merges *)",

      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push * develop)",
      "Bash(git push * develop *)",
      "Bash(git push *:develop)",
      "Bash(git push *:develop *)",
      "Bash(git push *refs/heads/develop)",
      "Bash(git push *refs/heads/develop *)",
      "Bash(git push *--all*)",

      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",

      "Bash(git push * --delete main)",
      "Bash(git push * --delete main *)",
      "Bash(git push * -d main)",
      "Bash(git push * -d main *)",
      "Bash(git push * --delete develop)",
      "Bash(git push * --delete develop *)",
      "Bash(git push * -d develop)",
      "Bash(git push * -d develop *)",
      "Bash(gh api *refs/heads/main)",
      "Bash(gh api *refs/heads/main *)",
      "Bash(gh api *refs/heads/develop)",
      "Bash(gh api *refs/heads/develop *)",

      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *statuses/*)",
      "Bash(scripts/protect-branches.sh)",
      "Bash(./scripts/protect-branches.sh)",
      "Bash(bash scripts/protect-branches.sh)",

      "Bash(rsync *:*)",
      "Bash(rsync -e *)",
      "Bash(rsync * -e *)",
      "Bash(rsync *--rsh*)",

      "Bash(deploy/deploy.sh *)",
      "Bash(./deploy/deploy.sh *)",
      "Bash(bash deploy/deploy.sh *)",
      "Bash(bash ./deploy/deploy.sh *)",
      "Bash(sh deploy/deploy.sh *)",
      "Bash(*/deploy/deploy.sh *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(//**/.env)",
      "Read(~/.config/bona-fide)",
      "Read(~/.config/bona-fide/**)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(cast wallet private-key *)",
      "Bash(cast wallet decrypt-keystore *)",

      "Bash(cast send *rpc.mainnet.arc.io*)",
      "Bash(cast publish *rpc.mainnet.arc.io*)",
      "Bash(forge script *rpc.mainnet.arc.io*--broadcast*)",
      "Bash(forge script *--broadcast*rpc.mainnet.arc.io*)",
      "Bash(*CONFIRM_MAINNET=yes*)",
      "Bash(export CONFIRM_MAINNET=*)"
    ]
  }
}
